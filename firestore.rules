rules_version = '2';
// =====================================================================
//  QUY TẮC BẢO MẬT FIRESTORE – dán vào Firebase console → Firestore → Rules
//  Vai trò lưu ở collection "roles", id tài liệu = email (chữ thường):
//    role   = quyền mặc định cho mọi nhà: none | viewer | editor | admin
//    houses = quyền riêng theo nhà, ví dụ {nk: 'editor', nvp: 'viewer'}
//  Người có role = 'admin' được quản lý người dùng.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    // >>> SỬA EMAIL CHỦ HỆ THỐNG Ở ĐÂY (trùng với js/config.js) <<<
    function isOwner() {
      return signedIn() && myEmail() in ['dangvandangdvd@gmail.com'];
    }
    function rdoc() {
      return get(/databases/$(database)/documents/roles/$(myEmail())).data;
    }
    function hasRole() {
      return signedIn() && exists(/databases/$(database)/documents/roles/$(myEmail()));
    }
    // Quyền trên 1 nhà = quyền riêng của nhà đó (nếu có), ngược lại = quyền mặc định
    function roleIn(h) {
      return rdoc().get('houses', {}).get(h, rdoc().get('role', 'none'));
    }
    // Mã nhà = phần đầu id mặt bằng: nsp, nk, nvp, npt1, npt2, nx, nsl
    function houseOf(pid) { return pid.split('-')[0]; }
    function isAdmin()  { return isOwner() || (hasRole() && rdoc().get('role', 'none') == 'admin'); }
    function adminIn(pid) { return isOwner() || (hasRole() && roleIn(houseOf(pid)) == 'admin'); }
    function editIn(pid)  { return isOwner() || (hasRole() && roleIn(houseOf(pid)) in ['editor', 'admin']); }
    function viewIn(pid)  { return isOwner() || (hasRole() && roleIn(houseOf(pid)) in ['viewer', 'editor', 'admin']); }

    // Danh sách người dùng & quyền
    match /roles/{email} {
      allow get: if isAdmin() || (signedIn() && email == myEmail());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.role in ['none', 'viewer', 'editor', 'admin']
        && request.resource.data.keys().hasOnly(['role', 'name', 'houses', 'by', 'at'])
        && request.resource.data.get('houses', {}).values().hasOnly(['none', 'viewer', 'editor', 'admin']);
      allow delete: if isAdmin();
    }

    // Dự án (mặt bằng) và dữ liệu móng
    match /projects/{pid} {
      allow read: if viewIn(pid);
      allow write: if adminIn(pid);

      match /mong/{mid} {
        allow read: if viewIn(pid);
        allow delete: if adminIn(pid);
        allow create, update: if editIn(pid)
          && request.resource.data.keys().hasOnly(['d', 'by', 'byName', 'at', 'h', 'src'])
          && request.resource.data.d is list
          && request.resource.data.d.size() == 6
          && request.resource.data.by == request.auth.uid
          && request.resource.data.h is list
          && request.resource.data.h.size() <= 30;
      }
    }

    // Mọi thứ khác: cấm
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
